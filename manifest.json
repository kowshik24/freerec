{
  "manifest_version": 3,
  "name": "FreeRec – Screen & Camera Recorder",
  "short_name": "FreeRec",
  "version": "1.1.0",
  "description": "Free, local screen + camera recorder with effects and screenshots. No account, no plan. Saves straight into a folder you choose.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FreeRec – record your screen",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "desktopCapture",
    "tabCapture",
    "scripting",
    "activeTab",
    "storage",
    "unlimitedStorage",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Open the FreeRec panel"
    },
    "stop-recording": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Finish recording and save"
    },
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause / resume recording"
    },
    "cancel-recording": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Cancel recording (discard)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html", "panel.css", "panel.js", "stage.css",
        "camera.html", "camera.js",
        "lib/*", "vendor/mediapipe/*", "vendor/mediapipe/wasm/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
